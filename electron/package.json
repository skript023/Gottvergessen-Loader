{
  "name": "astra",
  "version": "1.0.0",
  "private": true,
  "description": "Astra desktop application",
  "main": "main.js",
  "scripts": {
    "native:configure": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1 -ConfigureOnly",
    "native:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "build:ui": "vite build",
    "dev:ui": "vite",
    "start": "npm run build:ui && electron .",
    "dev": "npm run build:ui && npm run native:build && electron .",
    "version:bump": "npm version patch --no-git-tag-version",
    "dist": "npm run build:ui && npm run native:build && electron-builder --win --x64"
  },
  "dependencies": {
    "koffi": "3.1.6",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "43.0.0",
    "electron-builder": "26.15.3",
    "typescript": "~5.7.3",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.8"
  },
  "build": {
    "appId": "com.ellohim.astra",
    "productName": "Astra",
    "artifactName": "Astra-${version}-portable.${ext}",
    "directories": {
      "buildResources": "../src"
    },
    "files": [
      "main.js",
      "preload.js",
      "gameScanner.js",
      "gameArt.js",
      "updater.js",
      "dist-renderer/**/*",
      "renderer/**/*",
      "node_modules/**/*",
      "serverStatus.js"
    ],
    "extraResources": [
      {
        "from": "../out/build/electron/bin/Release/native-core.dll",
        "to": "native/native-core.dll"
      },
      {
        "from": "../out/build/electron/bin/Release/update-runner.exe",
        "to": "native/update-runner.exe"
      },
      {
        "from": "../src/logo.ico",
        "to": "assets/logo.ico"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "logo.ico"
    },
    "portable": {
      "unpackDirName": "Astra"
    }
  }
}
